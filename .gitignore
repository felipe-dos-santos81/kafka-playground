# Go build and test output (go build in producer/, studio/ or topic-owner/; go test -c, -coverprofile)
/producer/producer
/studio/studio
/topic-owner/topic-owner
*.test
*.out

# Studio UI: dependencies and build output (keep the placeholder go:embed needs)
/studio/ui/node_modules/
/studio/ui/dist/*
!/studio/ui/dist/.gitkeep
/studio/ui/test-results/
/studio/ui/playwright-report/
/studio/ui/.chromium
*.tsbuildinfo

# Agent scratch space and worktrees
/.superpowers/
/.claude/worktrees/

# OS / editor
.DS_Store
.idea/
.vscode/
